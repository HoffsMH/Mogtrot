<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\Blizzard_SharedXML\UI.xsd">
	<Frame name="MogtrotPinDaysSettingTemplate" inherits="SettingsListElementTemplate" mixin="MogtrotPinDaysSettingMixin" virtual="true">
		<Size x="280" y="26"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontHighlight" text="days" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Days" relativePoint="RIGHT" x="7"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox parentKey="Days" inherits="InputBoxTemplate" autoFocus="false" numeric="true" letters="5">
				<Size x="48" y="24"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="CENTER" x="-15"/>
				</Anchors>
				<Scripts>
					<OnTextChanged>self:GetParent():OnTextChanged(self, userInput)</OnTextChanged>
					<OnEnterPressed>self:GetParent():Commit(self); self:ClearFocus()</OnEnterPressed>
					<OnEscapePressed>self:GetParent():RestoreValue(); self:ClearFocus()</OnEscapePressed>
					<OnEditFocusLost>self:GetParent():Commit(self)</OnEditFocusLost>
				</Scripts>
			</EditBox>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
